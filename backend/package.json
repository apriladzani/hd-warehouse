{
  "name": "hd-warehouse-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "test:weighted-average": "node --import tsx --test tests/weighted-average.test.ts",
    "test:api": "NODE_ENV=test node --import tsx --test --test-concurrency=1 tests/api-smoke.test.ts",
    "db:migrate-timestamps": "node --import tsx scripts/migrate-timestamps.ts",
    "finance:backfill-outlets": "node --import tsx scripts/backfill-request-outlets.ts",
    "test:db": "DB_TESTS=1 node --import tsx --test --test-concurrency=1 tests/outlet-attribution.db.test.ts",
    "finance:rebuild-periods": "node --import tsx scripts/rebuild-period-snapshots.ts",
    "test:finance": "node --import tsx --test tests/outlet-scope.test.ts tests/period-ledger.test.ts tests/finance.test.ts tests/finance-readonly.test.ts tests/finance-outlet-http.test.ts tests/operational-session.test.ts tests/finance-transactions.test.ts tests/period-inventory.test.ts tests/warehouse-reconciliation.test.ts tests/warehouse-simple-finance.test.ts tests/dashboard-access.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
