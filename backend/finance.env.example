# This is a template ONLY, never loaded as runtime configuration.
# Put real FINANCE_DB_* values in backend/.env or exported process variables.
# Exported variables take precedence; restart npm run dev:backend after editing.
# Quote passwords containing # in the .env file. Do not replace the existing
# operational DB_* configuration or commit real credentials.
